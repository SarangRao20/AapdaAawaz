# Copy to .env (repo root) or backend/.env. Real environment variables take precedence.
# Never commit a real key.

# --- Gnani (vachana.ai) — https://docs.gnani.ai -------------------------------
# Leave empty to run fully offline with the clearly-labelled mock STT and text-only acknowledgements.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# auto = Prisma when GNANI_API_KEY is set, otherwise the mock fixture lookup | prisma | mock
STT_PROVIDER=auto
# auto = Timbre when GNANI_API_KEY is set | none
TTS_PROVIDER=auto
# rules (default) | evon (Evon v3.3 is open weights, so this needs your own
# OpenAI-compatible deployment: set EVON_BASE_URL and EVON_MODEL below)
EXTRACTION_PROVIDER=rules

PRISMA_DEFAULT_LANGUAGE=hi-IN
PRISMA_TIMEOUT_S=30
PRISMA_MAX_RETRIES=2

# --- Evon LLM extraction (active when EXTRACTION_PROVIDER=evon) ---------------
# EVON_API_KEY=            # optional; falls back to GNANI_API_KEY
# EVON_BASE_URL=https://api.vachana.ai/v1
# EVON_MODEL=evon-v3.3
# EVON_TIMEOUT_S=60
# EVON_MAX_RETRIES=2

# Prisma v3.0 adds village-name hints. Set prisma-v2.5 to compare. Format: verbatim or codemix.
PRISMA_MODEL=prisma-v3.0
PRISMA_FORMAT=verbatim

# The model and voices must match: timbre-v3.0 rejects v2.5 voice names (Ishaan, Nalini,
# Kaveri, Poorvi) with HTTP 400, and those names only work with TIMBRE_MODEL=timbre-v2.5.
TIMBRE_MODEL=timbre-v3.0
TIMBRE_VOICE_MR=Shivani
TIMBRE_VOICE_HI=Shivani
TIMBRE_VOICE_EN=Shivani
TIMBRE_VOICE_MIXED=Shivani
TIMBRE_TIMEOUT_S=30

# --- Optional enrichment -----------------------------------------------------
# Geocode unmapped caller-stated places via Nominatim/OSM (free, no key needed).
# Requires internet access; adds ~3 s latency to extraction for unmapped places.
GEOCODING_ENABLED=false

# Spectral noise gate + RMS normalisation applied to uploaded audio before Prisma STT.
# Off because it didn't improve on Prisma in our test (docs/STT_BENCHMARK.md). Requires numpy/scipy/noisereduce/soundfile.
AUDIO_PREPROCESSING=false

# --- Telegram bot (optional) ---------------------------------------------------
# Create a bot with @BotFather in Telegram and paste its token here. Never commit it.
# TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Empty = anyone who finds it.
# TELEGRAM_ALLOWED_CHAT_IDS=
# Repeat an unanswered question every N seconds, and stop after this many attempts.
# TELEGRAM_FOLLOWUP_INTERVAL_S=120
# TELEGRAM_FOLLOWUP_MAX_ATTEMPTS=3
# Send questions as voice notes too (uses Timbre credits; identical questions are reused).
# TELEGRAM_VOICE_REPLIES=true

# --- Dashboard login -----------------------------------------------------------
# Required: with no password nobody can log in. Use a long password and never commit it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Keeps people logged in across backend restarts. Empty = a new key on each start.
# SESSION_SECRET=
# Set to true once the dashboard is served over HTTPS.
# COOKIE_SECURE=false
# Lets the MCP server use the API. Give it the same value as AAPDA_API_TOKEN.
# API_TOKEN=

# --- Twilio telephony (optional) ----------------------------------------------
# Inbound calls to this number run the emergency intake; outbound /api/twilio/call
# lets a trial account call a verified number instead.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- App ---------------------------------------------------------------------
# SQLite database, uploads and generated audio live here (default: backend/var)
# AAPDA_VAR_DIR=
# DATABASE_URL=sqlite:///absolute/path/to/aapda.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
